--1 impedir fecha ilogica en libro

DELIMITER //

CREATE TRIGGER fecha_incorrecta
BEFORE INSERT ON libros
FOR EACH ROW

  IF NEW.fecha_libro > NOW() THEN
    SET MESSAGE_TEXT = 'Fecha de publicacion no valida, Comprobar fecha de publicacion';
    LEAVE;
  END IF;
END;

DELIMITER ;

--2 Nombre de libro con menos de 3 caracteres

DELIMITER //

CREATE TRIGGER nombre_corto_libro
BEFORE INSERT ON usuarios
FOR EACH ROW
BEGIN //

  IF LENGHT(TRIM(NEW.usuario)) < 3 THEN
    SET MESSAGE_TEXT = 'Nombre de usuario invalido, nombre menor a 3 caracteres'
  END IF;

END;

DELIMITER ;

--3 impedir que la fecha de devolucion sea menor a la fecha de prestamo

DELIMITER //

CREATE TRIGGER fecha_erronea
BEFORE INSERT ON prestamos
FOR EACH ROW
BEGIN //

  IF NEW.fecha_devolucion < NEW.fecha_prestamo THEN
    SET MESSAGE_TEXT = 'La fecha de devolucion es anterior a la de prestamo';
    LEAVE;
  END IF;
END;

DELIMITER ;

--4 Convertir el nombre de un genero a mayuscula antes de insertarlo

DELIMITER //

CREATE TRIGGER mayusc_generos
BEFORE INSERT ON generos
FOR EACH ROW
BEGIN

  SET NEW.nombre = UPPER(TRIM(NEW.nombre));

END;

DELIMITER ;

--5 Convertir el nombre de autor a formato titulo

DELIMITER //

CREATE TRIGGER nombre_autor_mayusc
BEFORE INSERT ON autores
FOR EACH ROW
BEGIN //

  SET NEW.nombre INTO UPPER(TRIM(NEW.nombre));

END;

DELIMITER ;

