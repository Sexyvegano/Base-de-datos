--3 Productos sin stock
DELIMITER //

CREATE PROCEDURE productos_sin_stock()
BEGIN
    DECLARE v_nombre VARCHAR(100);
    DECLARE fin INT DEFAULT FALSE;

    DECLARE cur_sin_stock CURSOR FOR 
        SELECT nombre FROM productos WHERE stock = 0;

    DECLARE CONTINUE HANDLER FOR NOT FOUND SET fin = TRUE;

    OPEN cur_sin_stock;

    bucle: LOOP
        FETCH cur_sin_stock INTO v_nombre;
        IF fin THEN
            LEAVE bucle;
        END IF;

        SELECT CONCAT('Producto sin stock: ', v_nombre) AS Alerta;
    END LOOP;

    CLOSE cur_sin_stock;
END //

DELIMITER ;

--4 Determinar categoria por precio

DELIMITER//
BEGIN

  DECLARE v_nombre VARCHAR(100),
  DECLARE v_precio DECIMAL(10,2);
  DECLARE v_categoria VARCHAR(20);
  DECLARE fin INT DEFAULT FALSE;

  DECLARE cur_precio CURSOR FOR
    SELECT nombre, precio from productos;

  DECLARE CONTINUE HANDLER FOR NOT FOUND SET fin = TRUE;

  OPEN cur_precio;

  bucle: LOOP
    FETCH cur_precio INTO v_nombre, v_precio;
    IF fin THEN
      LEAVE bucle;
    END IF;
    IF v_precio < 10000 THEN
      SET v_categoria = 'BARATO';
    ELSEIF v_precio => 10000 AND v_precio < 50000 THEN
      SET v_categoria = 'MEDIO';
    ELSE
      SET v_categoria = "CARO";
    END IF;

    SELEC CONCAT('Producto: ', v_nombre, ' | Precio: $', v_precio, ' | Categoria: ', v_categoria) AS Info;
  END LOOP;

  CLOSE cur_precio;
END//

DELIMITER;

