--7 Actualizar stock: +10 si < 5, +5 si >= 5 y <20

DELIMITER//
BEGIN

    DECLARE v_id INT;
    DECLARE v_stock;
    DECLARE v_nuevostock;
    DECLARE fin INT DEFAULT FALSE;

    DECLARE cur_aumentostock CURSOR FOR
        SELECT id, stock FROM productos;

    DECLARE CONTINUE HANDLER FOR NOT FOUND IN SET fin = TRUE;

    OPEN cur_aumentostock;

    bucle:LOOP    
        FETCH cur_aumentostock INTO v_id, v_stock;
        IF fin THEN
            LEAVE bucle;
        END IF;
        IF v_stock < 5 THEN
            v_nuevostock = v_stock+10,
        ELSEIF v_stock => 5 AND <20 THEN
            v_nuevostock = v_stock+5;
        END IF;

        UPDATE productos SET stock = v_nuevostock WHERE id = v_id;

    END LOOP;
    CLOSE cur_aumentostock;
END//

DELIMITER;

--8 Listar compras con informacion del cliente

DELIMITER//
BEGIN

    DECLARE v_id_compra INT;
    DECLARE v_cliente VARCHAR(100);
    DECLARE v_producto VARCHAR(100);
    DECLARE v_cantidad INT;
    DECLARE v_fecha DATETIME;
    DECLARE din INT DEFAULT FALSE;

    DECLARE cur_compras CURSOR FOR
        SELECT 
            c.id,
            cl.nombre AS cliente,
            p.nombre AS producto,
            c.cantidad,
            c.fecha
        FROM compras c
        JOIN clientes cl on c.id_cliente = cl.id
        JOIN productos p on c.id_producto = p.id;

    DECLARE CONTINUE HANDLER FOR NOT IN SET fin = TRUE;

    OPEN cur_compras;

    bucle:LOOP
        FETCH cur_compras INTO v_id_compra, v_cliente, v_producto, v_cantidad, v_fecha;
        IF fin THEN
            LEAVE bucle;
        END IF;
        
        SELECT CONCAT(
            'Compra: #', v_id_comrpa, 
            ' | Cliente: ', v_cliente, 
            ' | Producto: ', v_producto, 
            ' | Cantidad: ', v_cantidad, 
            ' | Fecha: ', v_fecha) AS Detallecompra;

    END LOOP;
    CLOSE cur_compras;
END//

