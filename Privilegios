--5 Tabla auditoria para todos los cambios de usuarios

DELIMETER //

  CREATE TRIGGER auditoria_insert
  AFTER INSERT INTO productos
  FOR EACH ROW
  BEGIN //
    INSERT INTO auditoria(accion, tiempo)
      VALUES(CONCAT('Producto insertado: ', NEW.nombre, ' | Precio: $', NEW.precio, ' | Stock: ', NEW.stock), NOW());
  END//

  CREATE TRIGGER auditoria_delete
  AFTER delete INTO productos
  FOR EACH ROW
  BEGIN //
    INSERT INTO auditoria(accion, tiempo)
      VALUES(CONCAT('Producto borrado: ', OLD.nombre, ' | Precio: $', OLD.precio, ' | Stock: ', OLD.stock), NOW());
  END//

  CREATE TRIGGER auditoria_update
  AFTER update INTO productos
  FOR EACH ROW
  BEGIN //
    INSERT INTO auditoria(accion, tiempo)
      VALUES(CONCAT('Producto modificado: ', OLD.nombre, '=>', NEW.nombre ,' | Precio: $', OLD.precio, '=>', NEW.precio, ' | Stock: ', OLD.stock, '=>', NEW.stock), NOW());
  END//

DELIMETER ;
