--2 Crear un gestor de inventario

DELIMITER //

CREATE TRIGGER todavia_hay_stock()
BEFORE DELETE ON productos
FOR EACH ROW
BEGIN

  IF OLD.stock > 0 THEN
    SET MESSAGE_TEXT ='Todavia queda stock'
    LEAVE;
  END IF;
END //

DELIMITER ;

CREATE USER 'gestor_inventarios'@'localhost' IDENTIFIED BY 'yoborroloquequiero';

GRANT SELECT, UPDATE, INSERT, DELETE ON productos TO 'gestor_inventarios'@'localhost';
