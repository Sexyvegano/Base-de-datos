--1 Capitalizar la primer letra de cada cliente

DELIMITER//
CREATE PROCEDURE capitalizar_nombre_clientes();
BEGIN
  DECLARE v_id INT;
  DECLARE v_nombre VARCHAR(100);
  DECLARE v_nombrenuevo VARCHAR(100);
  DECLARE FIN INT DEFAULT FALSE;

  DECLARE cur_clientes CURSOR FOR
    SELECT id, nombre FROM clientes;

  DECLARE CONTINUE HANDLER FOR NOT FOUND SET fin = TRUE;

  OPEN cur_clientes;

  bucle:LOOP
    FETCH cur_clientes INTO v_id, v_nombre;
    IF fin THEN
      LEAVE bucle;
    END IF;
    SET v_nombrenuevo = CONCAT(
      UPPER(LEFT(v_nombre, 1),
      LOWER(SUBSTRING(v_nombre, 2))
    );

    UPDATE clientes SET nombre = v_nombrenuevo WHERE id = v_id;

  END LOOP;
  CLOSE cur_clientes;
END//

DELIMITER;

--2 Subtotal por region y ranking de provincias por poblacion

DELIMITER//

CREATE PROCEDURE subtotal_y_ranking_provincias(),
BEGIN

  DECLARE v_provincia VARCHAR(100);
  DECLARE v_region VARCHAR(100);
  DECLARE v_poblacion INT;
  DECLARE V_region_actual VARCHAR(100) DEFAULT '';
  DECLARE v_subtotal_region BIGINT DEFAULT 0;
  DECLARE v_rank INT DEFAULT 0;
  DECLARE finINT DEFAULT FALSE;

  DECLARE cur_poblacion CURSOR FOR
    SELECT provincia, region, poblacion 
    FROM provincias
    ORDER BY region ASC, poblacion DESC;

  DECLARE CONTINUE HANDLER FOR NOT FOUND SET fin = TRUE;

  OPEN cur_poblacion;

  bucle:LOOP
    FETCH cur_poblacion INTO v_provincia, v_region, v_poblacion;
    IF fin THEN
      IF v_region_actual != '' THEN
        SELECT CONCAT('TOTAL REGION ', v_region_actual, ': ', v_subtotal_region, ' HABITANTES) AS Subtotal;
      END IF;
      LEAVE bucle;

    IF v_region_actual != '' AND v_region_actual != v_region THEN
      SELECT CONCAT('TOTAL REGION ', v_region_actual, ': ', v_subtotal_region, ' HABITANTES) AS Subtotal;
      SET v_subtotal_region = 0;
      SET v_rank = 0;
    END IF;

    SET v_region_actual = v_region;
    SET v_subtotal_region = v_subtotal_region + v_poblacion;
    SET v_rank = v_rank + 1;

    SELECT CONCAT('Region: ', v_region, ' | Ranking #', v_rank, ' | Provincia: ' v_provincia, ' | Poblacion: ', v_poblacion) AS Detalle;
  END LOOP;
  CLOSE cur_poblacion;
END//

DELIMITER;

--3 Actualizar stocks con tabla auditoria

DELIMITER //

CREATE PROCEDURE reponer_stock_con_auditoria();
BEGIN
  DECLARE v_id INT;
  DECLARE v_nombre VARCHAR(100);
  DECLARE v_stock INT,
  DECLARE fin INT DEFAULT FALSE;

  DECLARE cur_reponer_stock CURSOR FOR
    SELECT id, nombre, stock FROM productos;

  DECLARE CONTINUE HANDLER FOR NOT FOUND SET fin = TRUE;

  OPEN cur_reponer_stock;

  bucle:LOOP
    FETCH cur_reponer_stock INTO v_id, v_nombre, v_stock;
    IF fin THEN
      LEAVE bucle;
    END IF;
    IF v_stock < 5 THEN
      UPDATE productos SET stock = stock + 20 WHERE id = v_id;
      SELECT CONCAT('Se repusieron + 20 unidades en el producto', v_nombre, ' | Anterior stock: ', v_stock) AS Info;
      INSERT INTO auditoria_stock(id_producto, fecha, descripcion)
        VALUES(v_id, NOW(), CONCAT('Se repusieron + 20 unidades en el producto', v_nombre, ' | Anterior stock: ', v_stock);
    END IF;
  END LOOP;
  CLOSE cur_reponer_stock;
END//

DELIMITER;

--4 Cliente favorito por ciudad

DELIMITER //

CREATE FUNCTION contar_compras_clientes(p_id_cliente INT);
RETURNS INT
DETERMINISTIC
BEGIN
  DECLARE v_total INT;
  SELECT COUNT(*) INTO v_total FROM compras WHERE id_cliente = p_id_cliente;
  RETURN v_total;
END //

DELIMITER;

DELIMITER //

CREATE PROCEDURE clientes_favoritos_por_ciudad();
BEGIN
  DECLARE v_ciudad VARCHAR(100);
  DECLARE v_id_mas_compras INT;
  DECLARE v_nombre_mas_compras VARCHAR(100);
  DECLARE v_cant_compras INT;
  DECLARE v_id_mas_gastado
  DECLARE v_nombre_mas_gastado VARCHAR(100);
  DECLARE v_total_gastado DECIMAL (12,2);
  DECLARE fin INT DEFAULT FALSE;

  DECLARE cur_ciudades CURSOR FOR
    SELECT DISTINCT ciudad FROM clientes WHERE ciudad IS NOT NULL;

  DECLARE CONTINUE HANDLER FOR NOR FOUND SET fin = TRUE;

  OPEN cur_ciudades;

  bucle:LOOP
    FETCH cur_ciudades INTO v_ciudad;
    IF fin THEN
      LEAVE bucle;
    END IF;

    SELECT c.id, c.nombre, contar_compras_clientes(c.id) AS total_compras
    INTO v_id_mas_compras, v_nombre_mas_compras, v_cant_compras
    FROM clientes c
    WHERE c.ciudad = v_ciudad
    ORDER BY total_compras DESC, c.id ASC
    LIMIT 1;

    SELECT c.id, c.nombre, SUM(co.monto_total) AS total_gastado
    INTO v_id_mas_gastado, v_nombre_mas_gastado, v_total_gastado
    FROM clientes c
    JOIN compras co ON c.id = co.id_cliente
    ORDER BY v_total_gastado DESC, c.id ASC
    LIMIT 1;

    SELECT CONCAT('Cliente con mas compras: ', v_nombre_mas_compras, ' | Cantidad de compras: ', v_cant_compras) AS Mascompras;
    SELECT CONCAT('Cliente que mas gast0: ', v_nombre_mas_gastado, ' | Cantidad gastada: $', v_total_gastado) AS Masgastado;
  END LOOP;
  CLOSE cur_ciudades;
END //

DELIMITER;

--5 Total gastado por cada cliente de cada provincia

DELIMETER //

CREATE FUNCTION dinero_gastado_cliente(p_cliente_id INT)
RETURNS DECIMAL(12,2)
DETERMINISTIC
BEGIN

  DECLARE v_monto_total(12,2);
  SELECT SUM(monto_total)
  INTO v_monto_total
  FROM compras
  WHERE id_cliente = p_cliente_id;

  RETURN v_monto_total;

END //

DELIMITER;

DELIMETER //

CREATE PROCEDURE reporte_completo_provincias()
BEGIN

  DECLARE v_provincia VARCHAR(100);
  DECLARE fin_prov INT DEFAULT DETERMINISTIC;
  DECLARE v_id_cliente INT;
  DECLARE v_nombre VARCHAR(100);
  DECLARE v_gasto DECIMAL(12,2);
  DECLARE fin_cli INT DEFAULT FALSE;

  DECLARE cur_provincias CURSOR FOR
    SELECT DISTINCT provincia FROM cliente WHERE provincia IS NOT NULL;

  DECLARE CONTINUE HANDLER FOR NOT FOUND SET fin_prov = TRUE;

  OPEN cur_provincias;

  bucle:LOOP
    FETCH cur_provincias
      INTO v_provincia;
    IF fin_prov THEN
      LEAVE bucle;
    END IF;

    SELECT CONCAT('Provincia: ', v_provincia) AS Titulo;

    BEGIN

      DECLARE cur_clientes CURSOR INTO
        SELECT id, nombre FROM clientes WHERE provincia = v_provincia;

      DECLARE CONTINUE HANDLER FOR NOR FOUND SET fin_cli = TRUE;
      
      SET fin_cli = FALSE;
      OPEN cur_cli;

      bucle:LOOP
        FETCH cur_cli INTO
          v_id_cliente, v_nombre;

        IF fin_cli THEN
          LEAVE bucle;
        END IF;

        SET v_gasto = dinero_gastado_cliente(v_id_cliente);

        SELECT CONCAT('cliente: ', v_nombre, ' | Dinero gastado; $', v_gasto) AS Info;

      END LOOP;

      CLOSE cur_clientes;
    END;

  END LOOP;

  CLOSE cur_provincias;

END //

DELIMETER ;
